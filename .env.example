# Groq API key (free at https://console.groq.com/keys). Without it Satyori runs retrieval-only:
# Ask shows the most relevant passages, and the Arena and Benchmark work fully.
GROQ_API_KEY=

# Model that writes answers, and the council used by Council mode (comma separated).
SATYORI_MODEL=openai/gpt-oss-120b
SATYORI_COUNCIL_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Local ONNX models (downloaded once by fastembed).
SATYORI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SATYORI_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Learned-sparse channel (~0.5 GB). Leave empty to switch it off on low-memory hosts;
# the default pipeline then falls back to dense + BM25.
SATYORI_SPLADE_MODEL=prithivida/Splade_PP_en_v1

# Chunking: target characters per passage, and sentences shared between neighbouring passages.
SATYORI_CHUNK_SIZE=700
SATYORI_CHUNK_OVERLAP=1
